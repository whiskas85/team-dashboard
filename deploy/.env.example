# Domain served by Caddy (DNS A record must point to this host)
DOMAIN=console.zerodarkteam.it
# Dashboard login password (required)
ADMIN_PASSWORD=change-me
# Bearer token for the external AI tool: GET /api/v1/export
EXPORT_TOKEN=change-me-too
# Rolling retention window in days (older data is deleted)
RETENTION_DAYS=30
# Agent report interval in seconds
AGENT_INTERVAL=60
# Peak threshold used by the placement engine (0.8 = 80%)
HEADROOM=0.8
TZ=Europe/Rome
